<div class="space-y-8">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Data import</h1>
    <p class="text-slate-600 mt-1 text-sm">
      Import the source dataset (customers, SKUs, GL accounts, vendors, usage
      events, POs, goods receipts) so the engine has something to accrue against.
      The engine runs against whatever you load — importing replaces all existing data.
    </p>
  </div>

  <% if @schema_errors && @schema_errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-900">
      <div class="font-medium">Schema validation failed.</div>
      <p class="mt-1 text-red-800">The uploaded file doesn't match the expected layout. Existing data is unchanged.</p>
      <ul class="mt-2 space-y-0.5 list-disc list-inside font-mono text-xs">
        <% @schema_errors.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if reference_loaded? %>
    <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
      <div class="font-medium">Reference data loaded.</div>
      <div class="mt-1 text-emerald-800">
        <%= @counts[:customers] %> customers ·
        <%= @counts[:skus] %> SKUs ·
        <%= @counts[:gl_accounts] %> GL accounts ·
        <%= @counts[:vendors] %> vendors ·
        <%= @counts[:usage_events] %> usage events ·
        <%= @counts[:purchase_orders] %> POs ·
        <%= @counts[:goods_receipts] %> goods receipts.
      </div>
      <a href="/closes" class="inline-block mt-2 font-medium underline">Go to closes &rarr;</a>
    </div>
  <% else %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      <div class="font-medium">No reference data loaded.</div>
      <div class="mt-1">Upload an XLSX or load the bundled sample to begin.</div>
    </div>
  <% end %>

  <div class="rounded-lg border border-slate-200 bg-white p-6">
    <form method="post" action="/import" enctype="multipart/form-data" class="space-y-5"
          onsubmit="return confirmImport(this);">
      <div>
        <label for="anchor_file" class="block text-sm font-medium text-slate-700 mb-1">
          Source XLSX
        </label>
        <input type="file" name="anchor_file" id="anchor_file" accept=".xlsx" required
               class="block w-full text-sm text-slate-700 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200">
        <p class="mt-2 text-xs text-slate-500">
          Expected sheets: customers, sku_price_book, vendors, gl_accounts,
          usage_events, chargebee_invoices, purchase_orders, po_lines,
          goods_receipts, vendor_invoices.
        </p>
      </div>

      <fieldset>
        <legend class="block text-sm font-medium text-slate-700 mb-2">Import mode</legend>
        <div class="space-y-2">
          <label class="flex items-start gap-2 text-sm">
            <input type="radio" name="mode" value="replace" checked class="mt-0.5">
            <span>
              <span class="font-medium">Replace existing data</span>
              <span class="block text-xs text-slate-500">Wipe all reference + engine state, then seed from this file. Original behavior.</span>
            </span>
          </label>
          <label class="flex items-start gap-2 text-sm">
            <input type="radio" name="mode" value="append" class="mt-0.5">
            <span>
              <span class="font-medium">Add to existing data</span>
              <span class="block text-xs text-slate-500">Insert new rows; skip any whose natural key (customer_id, event_id, receipt_id, &hellip;) already exists. Useful for adding a later month's events.</span>
            </span>
          </label>
        </div>
      </fieldset>

      <div>
        <button type="submit"
                class="inline-flex items-center rounded-md bg-slate-900 text-white text-sm font-medium px-4 py-2 hover:bg-slate-800 shadow-sm">
          Import
        </button>
      </div>
    </form>
  </div>

  <script>
    function confirmImport(form) {
      var mode = form.elements['mode'].value;
      var msg = mode === 'append'
        ? 'Add rows from this file? Existing rows whose natural key matches will be skipped; existing data is preserved.'
        : 'Replace ALL existing data (reference + engine state) with the contents of this file?';
      return confirm(msg);
    }
  </script>

  <% if sample_anchor_available? || sample_demo_available? %>
    <div class="flex items-center gap-3 text-sm">
      <div class="flex-1 border-t border-slate-200"></div>
      <span class="text-slate-400 uppercase tracking-wide text-xs">or</span>
      <div class="flex-1 border-t border-slate-200"></div>
    </div>
  <% end %>

  <% if sample_anchor_available? %>
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <div class="flex items-start justify-between gap-6">
        <div>
          <div class="text-sm font-medium text-slate-900">Helix anchor (canonical)</div>
          <p class="text-sm text-slate-600 mt-1">
            The brief's reference dataset: 3 customers, 1 vendor, 1 PO, 1 seeded anomaly.
            Targets: AR $362.50 · AP $100,000 · total $100,362.50.
          </p>
        </div>
        <form method="post" action="/import/sample"
              onsubmit="return confirm('Load the bundled Helix anchor? All existing data will be replaced.');">
          <button type="submit"
                  class="inline-flex items-center rounded-md border border-slate-300 bg-white text-slate-700 text-sm font-medium px-4 py-2 hover:bg-slate-50 shadow-sm whitespace-nowrap">
            Load canonical
          </button>
        </form>
      </div>
    </div>
  <% end %>

  <% if sample_demo_available? %>
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <div class="flex items-start justify-between gap-6">
        <div>
          <div class="text-sm font-medium text-slate-900">Helix expanded demo</div>
          <p class="text-sm text-slate-600 mt-1">
            Same company, richer data: 6 customers across USD/EUR/JPY/GBP/SGD, 5 SKUs, 2 POs.
            Exercises every skip path:
            CUS-1001 + CUS-1004 anomalies flag (accrue actual);
            CUS-1006 has no events in the unbilled window (AR skipped);
            GR-2026-0042 is fully vendor-invoiced (AP skipped);
            GR-2026-0043 is partially vendor-invoiced (accrues remainder).
            Targets: AR $1,042.50 · AP $30,000 · total $31,042.50.
          </p>
        </div>
        <form method="post" action="/import/demo"
              onsubmit="return confirm('Load the expanded demo? All existing data will be replaced.');">
          <button type="submit"
                  class="inline-flex items-center rounded-md border border-slate-300 bg-white text-slate-700 text-sm font-medium px-4 py-2 hover:bg-slate-50 shadow-sm whitespace-nowrap">
            Load expanded demo
          </button>
        </form>
      </div>
    </div>
  <% end %>
</div>
