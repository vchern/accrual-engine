<div class="space-y-8">
  <div class="flex items-end justify-between">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Period closes</h1>
      <p class="text-slate-600 mt-1 text-sm">Single accrual engine for AR (usage-based) and AP (Goods-Receipt-not-Invoiced).</p>
    </div>

    <form method="post" action="/closes" class="flex items-end gap-3">
      <div>
        <label for="period_end" class="block text-xs font-medium text-slate-600 mb-1">Period end</label>
        <input type="date" name="period_end" id="period_end" value="2026-03-31" required
               class="rounded-md border-slate-300 shadow-sm text-sm py-1.5 px-2 border">
      </div>
      <button type="submit"
              class="inline-flex items-center rounded-md bg-slate-900 text-white text-sm font-medium px-4 py-2 hover:bg-slate-800">
        Run engine
      </button>
    </form>
  </div>

  <% if @closes.empty? %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-white p-12 text-center">
      <p class="text-slate-600">No closes yet. Pick a period above and click <strong>Run engine</strong>.</p>
    </div>
  <% else %>
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-2.5 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Period</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Status</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Started</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Completed</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium uppercase tracking-wide text-slate-500">Accruals</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium uppercase tracking-wide text-slate-500">Flagged</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium uppercase tracking-wide text-slate-500">Total USD</th>
            <th class="px-4 py-2.5"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @closes.each do |c| %>
            <% t = @totals_by_close[c.id] %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3 text-sm font-medium text-slate-900"><%= date_str(c.period_end) %></td>
              <td class="px-4 py-3 text-sm"><%= status_pill(c.status) %></td>
              <td class="px-4 py-3 text-sm text-slate-600 num"><%= datetime(c.started_at) %></td>
              <td class="px-4 py-3 text-sm text-slate-600 num"><%= datetime(c.completed_at) %></td>
              <td class="px-4 py-3 text-sm text-right text-slate-700 num"><%= t[:accruals] %></td>
              <td class="px-4 py-3 text-sm text-right num">
                <% if t[:flagged].positive? %>
                  <span class="text-amber-700 font-medium"><%= t[:flagged] %></span>
                <% else %>
                  <span class="text-slate-400">0</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-right font-medium text-slate-900 num"><%= usd(t[:total]) %></td>
              <td class="px-4 py-3 text-right">
                <a href="/closes/<%= c.id %>" class="text-sm font-medium text-slate-700 hover:text-slate-900">View &rarr;</a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
