#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Default to a path inside the project tree (writable on Render free tier
# and matches config/database.rb's fallback). For hosts with a persistent
# volume, set DATABASE_PATH to e.g. /data/production.sqlite3.
DB_PATH="${DATABASE_PATH:-./db/production.sqlite3}"
mkdir -p "$(dirname "$DB_PATH")"

echo "[start] migrating ${APP_ENV:-production} db at ${DB_PATH}..."
bundle exec rake db:migrate

# Production deploys do NOT auto-seed — the user imports the source XLSX
# via /import in the UI (or clicks 'Load sample data' for the bundled
# Helix anchor). For local dev, run `bundle exec rake db:setup`
# explicitly to drop, migrate, and seed from the local XLSX.
echo "[start] skipping auto-seed (import via /import)"

echo "[start] launching puma on port ${PORT:-9292}..."
exec bundle exec puma -C config/puma.rb
